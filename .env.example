SQLITE_DB_PATH=data/pulse-crm.sqlite

# Ссылка на опубликованный CSV зашита в серверный модуль.
# Как часто автоматически опрашивать таблицу, в минутах
GOOGLE_SHEETS_SYNC_INTERVAL_MINUTES=1

# Серверные секреты Telegram-бота. Не добавлять префикс VITE_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет для проверки вебхука Telegram (см. scripts/set-telegram-webhook.mjs)
TELEGRAM_WEBHOOK_SECRET=
# Публичное имя бота — не секрет, нужно на клиенте для ссылки t.me/<bot>?start=<lead_id>
VITE_TELEGRAM_BOT_USERNAME=
